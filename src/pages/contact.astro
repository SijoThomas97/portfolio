---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { withBase } from '../utils/links';

const CONTACT_EMAIL = 'sijo.thomas0097@gmail.com';
const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
  'Portfolio contact form'
)}`;

const inputClass =
  'w-full px-4 py-3 rounded-lg bg-surface-light dark:bg-surface border border-border-light dark:border-border text-text-primary-light dark:text-text-primary placeholder-text-secondary-light dark:placeholder-text-secondary focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-colors duration-200';

const labelClass =
  'block text-sm font-medium text-text-primary-light dark:text-text-primary mb-2';

const errorClass = 'mt-2 text-sm text-red-600 dark:text-red-400';
---

<BaseLayout
  title="Contact"
  description="Have a project in mind or want to discuss ML engineering opportunities? Send me a message and I'll get back to you."
>
  <section class="max-w-2xl mx-auto px-4 md:px-6 py-20 md:py-24">
    <h1
      class="text-4xl font-bold tracking-tight text-text-primary-light dark:text-text-primary"
    >
      Get in Touch
    </h1>
    <p class="mt-4 text-body-lg text-text-secondary-light dark:text-text-secondary">
      Have a project in mind or want to discuss ML engineering opportunities? Send me a message
      and I'll get back to you.
    </p>

    <div
      id="contact-status"
      role="status"
      aria-live="polite"
      class="hidden mt-8 rounded-lg px-4 py-3 text-sm font-medium"
    ></div>

    <form
      id="contact-form"
      data-api-endpoint={withBase('/api/contact')}
      data-mailto-href={mailtoHref}
      method="POST"
      novalidate
      class="mt-10 space-y-6"
    >
      <div>
        <label for="name" class={labelClass}>
          Name <span class="text-accent-light dark:text-accent" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          minlength="2"
          maxlength="100"
          aria-required="true"
          aria-describedby="name-error"
          autocomplete="name"
          class={inputClass}
        />
        <p id="name-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="email" class={labelClass}>
          Email <span class="text-accent-light dark:text-accent" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          aria-required="true"
          aria-describedby="email-error"
          autocomplete="email"
          class={inputClass}
        />
        <p id="email-error" class={errorClass} hidden></p>
      </div>

      <div>
        <label for="message" class={labelClass}>
          Message <span class="text-accent-light dark:text-accent" aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          minlength="10"
          maxlength="5000"
          aria-required="true"
          aria-describedby="message-error"
          class={inputClass}></textarea>
        <p id="message-error" class={errorClass} hidden></p>
      </div>

      {/* Honeypot — hidden from sighted + AT users, bots that autofill every field trip it. */}
      <div class="sr-only" aria-hidden="true">
        <label for="company">Leave this field empty</label>
        <input
          type="text"
          id="company"
          name="company"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div>
        <button
          type="submit"
          id="contact-submit"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-accent-light dark:bg-accent text-primary-light dark:text-primary font-semibold hover:bg-accent-light-hover dark:hover:bg-accent-hover transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary-light dark:focus:ring-offset-primary disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Send Message
        </button>
        <p class="mt-3 text-sm text-text-secondary-light dark:text-text-secondary">
          Prefer email? Write to me directly at
          <a
            href={mailtoHref}
            class="text-accent-light dark:text-accent underline underline-offset-2 hover:no-underline"
          >
            {CONTACT_EMAIL}
          </a>
          .
        </p>
      </div>
    </form>

    <div class="mt-16 pt-8 border-t border-border-light dark:border-border">
      <p
        class="text-sm font-mono uppercase tracking-wider text-text-secondary-light dark:text-text-secondary mb-4"
      >
        Or find me on
      </p>
      <SocialLinks size={22} gap="gap-6" />
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Progressive enhancement for the contact form.
   *
   * - No JS at all: the form still has a real submit button and a visible
   *   mailto link right below it, so the page is fully usable.
   * - JS enabled + API configured (server/hybrid deploy with SMTP/Resend
   *   env vars set): submits via fetch to /api/contact, shows inline
   *   field errors and a status message, no page reload.
   * - JS enabled + static GitHub Pages build (no /api/contact route
   *   exists at all): the fetch 404s, and we fall back to opening the
   *   mailto link pre-filled with the visitor's message.
   */
  (function () {
    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement)) return;

    const statusEl = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit');
    const endpoint = form.dataset.apiEndpoint || '';
    const mailtoHref = form.dataset.mailtoHref || '';

    const fields = ['name', 'email', 'message'] as const;

    function setStatus(message: string, kind: 'success' | 'error') {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.remove('hidden');
      statusEl.classList.remove(
        'bg-green-500/10',
        'text-green-600',
        'dark:text-green-400',
        'bg-red-500/10',
        'text-red-600',
        'dark:text-red-400'
      );
      if (kind === 'success') {
        statusEl.classList.add('bg-green-500/10', 'text-green-600', 'dark:text-green-400');
      } else {
        statusEl.classList.add('bg-red-500/10', 'text-red-600', 'dark:text-red-400');
      }
    }

    function clearFieldErrors() {
      for (const field of fields) {
        const errorEl = document.getElementById(`${field}-error`);
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.setAttribute('hidden', '');
        }
        const input = document.getElementById(field);
        if (input) input.removeAttribute('aria-invalid');
      }
    }

    function showFieldErrors(errors: Record<string, string | undefined>) {
      for (const field of fields) {
        const message = errors[field];
        const errorEl = document.getElementById(`${field}-error`);
        const input = document.getElementById(field);
        if (message && errorEl && input) {
          errorEl.textContent = message;
          errorEl.removeAttribute('hidden');
          input.setAttribute('aria-invalid', 'true');
        }
      }
    }

    /**
     * Client-side pre-validation, mirroring src/lib/contact.schema.ts, so
     * invalid submissions get instant inline errors without a network
     * round-trip — and so validation states are exercisable even on the
     * static (no /api/contact) GitHub Pages build, where every fetch
     * would otherwise 404 straight to the mailto fallback before the
     * server ever gets a chance to validate anything.
     */
    function validateClientSide(payload: Record<string, string>): Record<string, string> {
      const errors: Record<string, string> = {};
      const name = (payload.name || '').trim();
      const email = (payload.email || '').trim();
      const message = (payload.message || '').trim();

      if (name.length < 2) errors.name = 'Name must be at least 2 characters.';
      else if (name.length > 100) errors.name = 'Name must be 100 characters or fewer.';

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errors.email = 'Enter a valid email address.';
      }

      if (message.length < 10) errors.message = 'Message must be at least 10 characters.';
      else if (message.length > 5000) errors.message = 'Message must be 5000 characters or fewer.';

      return errors;
    }

    function fallbackToMailto(message: string) {
      const data = new FormData(form as HTMLFormElement);
      const name = String(data.get('name') || '');
      const email = String(data.get('email') || '');
      const body = String(data.get('message') || '');
      const params = new URLSearchParams({
        subject: `Portfolio contact form — from ${name || 'a visitor'}`,
        body: `${body}\n\n— ${name} (${email})`,
      });
      setStatus(message, 'error');
      window.location.href = `${mailtoHref.split('?')[0]}?${params.toString()}`;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();
      setStatus('', 'success');
      if (statusEl) statusEl.classList.add('hidden');

      const formData = new FormData(form as HTMLFormElement);
      const payload = Object.fromEntries(formData.entries()) as Record<string, string>;

      const clientErrors = validateClientSide(payload);
      if (Object.keys(clientErrors).length > 0) {
        showFieldErrors(clientErrors);
        setStatus('Please fix the highlighted fields and try again.', 'error');
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (response.status === 404) {
          // No /api/contact route in this deployment (static build) — use mailto.
          fallbackToMailto(
            'This deployment serves a static site without a contact API — opening your email client instead.'
          );
          return;
        }

        const result = await response.json().catch(() => ({ ok: false, errors: {} }));

        if (response.ok && result.ok) {
          setStatus("Thanks — your message has been sent. I'll get back to you soon.", 'success');
          (form as HTMLFormElement).reset();
          return;
        }

        if (response.status === 503) {
          fallbackToMailto(
            result.errors?.form ||
              'The contact API is not configured on this deployment — opening your email client instead.'
          );
          return;
        }

        if (result.errors) {
          showFieldErrors(result.errors);
          setStatus(
            result.errors.form || 'Please fix the highlighted fields and try again.',
            'error'
          );
        } else {
          setStatus('Something went wrong. Please try again.', 'error');
        }
      } catch {
        fallbackToMailto('Could not reach the contact API — opening your email client instead.');
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      }
    });
  })();
</script>
